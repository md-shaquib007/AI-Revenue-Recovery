# =====================================================================
# REVIVE Environment Configuration (.env.example)
# =====================================================================

# Runtime environment: development | test | production
APP_ENV=development

# ---------------------------------------------------------------------
# Database Configuration (Neon Serverless Postgres / PostgreSQL / SQLite)
# ---------------------------------------------------------------------
# To use Neon Serverless Postgres, paste your Neon connection string below:
# Example: DATABASE_URL=postgresql://neondb_owner:npg_xyz123@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# REVIVE automatically converts postgresql:// -> postgresql+asyncpg:// and handles SSL requirements.

DATABASE_URL=sqlite+aiosqlite:///./revive.db

# ---------------------------------------------------------------------
# Razorpay Gateway Credentials
# ---------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_revive_key
RAZORPAY_KEY_SECRET=rzp_test_revive_secret
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret_revive_2026
RAZORPAY_ENABLE_LIVE_API=false

# ---------------------------------------------------------------------
# Operator Authentication (Command Center Admin)
# ---------------------------------------------------------------------
OPERATOR_USERNAME=ops
OPERATOR_PASSWORD=revive-ops-2026
JWT_SECRET=dev-only-change-me-in-production-revive-2026

# ---------------------------------------------------------------------
# Frontend CORS Origins
# ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------
# Optional AI LLM Keys / LiteLLM Proxy (Deterministic Fallback active by default)
# ---------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=vertex_ai/gemini-3.5-flash
OPENAI_BASE_URL=https://litellm-platform.penpencil.guru

# ---------------------------------------------------------------------
# Observability (Optional Sentry DSN)
# ---------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------
# Feature Flags (Uncomment to override defaults)
# ---------------------------------------------------------------------
# AUTH_REQUIRED=false
# CHAOS_ENABLED=true
# WORKER_ENABLED=true
# RATE_LIMIT_ENABLED=false
# CIRCADIAN_SEND_ENABLED=true
# LINK_FOLLOWUP_SECONDS=120
