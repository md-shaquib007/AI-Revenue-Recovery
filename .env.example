# =====================================================================
# REVIVE Enterprise Environment Configuration (.env)
# =====================================================================

# Runtime environment: development | test | production
APP_ENV=production
APP_NAME=REVIVE
APP_VERSION=2.1.0

# Security Secrets (Generate secure random 32+ char strings in production)
SECRET_KEY=revive_secret_key_prod_2026_enterprise_x89a
JWT_SECRET=revive_jwt_secret_enterprise_prod_2026_super_secure

# ---------------------------------------------------------------------
# Database Configuration (Neon Serverless PostgreSQL on AWS)
# ---------------------------------------------------------------------
# Example: DATABASE_URL=postgresql+asyncpg://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?ssl=require

# ---------------------------------------------------------------------
# Razorpay Gateway Credentials
# ---------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_revive_key
RAZORPAY_KEY_SECRET=rzp_test_revive_secret
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret_revive_2026
RAZORPAY_ENABLE_LIVE_API=false

# ---------------------------------------------------------------------
# Operator Authentication (Command Center Admin)
# ---------------------------------------------------------------------
OPERATOR_USERNAME=ops
OPERATOR_PASSWORD=revive-ops-2026

# ---------------------------------------------------------------------
# Frontend CORS Origins (Allows Render frontend / local dev)
# ---------------------------------------------------------------------
CORS_ORIGINS=*

# ---------------------------------------------------------------------
# AI Reasoner & LLM Gateway (LiteLLM / Gemini / OpenAI)
# ---------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=vertex_ai/gemini-3.5-flash
OPENAI_BASE_URL=https://litellm-platform.penpencil.guru

# ---------------------------------------------------------------------
# Feature Flags (Optimized for Render Deployment & Live Demos)
# ---------------------------------------------------------------------
AUTH_REQUIRED=false
CHAOS_ENABLED=true
WORKER_ENABLED=true
RATE_LIMIT_ENABLED=false
CIRCADIAN_SEND_ENABLED=true
LINK_FOLLOWUP_SECONDS=120
